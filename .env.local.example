# Supabase 프로젝트 설정 (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 네이버클라우드플랫폼(NCP) Maps API 클라이언트 ID
# https://console.ncloud.com/maps/application 에서 Web Dynamic Map 서비스로 애플리케이션 등록 후 발급
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-ncp-maps-client-id
